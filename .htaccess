# Hostinger serves this repository from the domain document root, so the built
# static site lives at the repo root (index.html + assets/ + page folders).
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_URI} ^/\.well-known/
  RewriteRule ^ - [L]

  # Serve real files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Pretty URLs: /pricing -> /pricing/index.html when prerendered
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Fallback for client-side routes
  RewriteRule ^ /index.html [L]
</IfModule>

DirectoryIndex index.html

# Block access to source files that get deployed alongside the build
<FilesMatch "\.(ts|tsx|lockb?|toml|md|yml|yaml)$">
  Require all denied
</FilesMatch>
RedirectMatch 403 ^/(src|node_modules|\.github|dist)/
