# Served from the domain document root (deploy branch = built static site).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let ACME / verification files through untouched
  RewriteCond %{REQUEST_URI} ^/\.well-known/
  RewriteRule ^ - [L]

  # Canonical URLs: never expose /public_html/... — redirect it away
  RewriteRule ^public_html/?$ / [R=301,L]
  RewriteRule ^public_html/(.*)$ /$1 [R=301,L]

  RewriteRule ^(?:(?:en|es|nl|fr|de|sv|pl|el|uk|ja|zh|tr|ar)/)?(?:resources|tutorials|academy)/?$ https://support.smarty.tel [R=302,L]
  RewriteRule ^(?:(?:en|es|nl|fr|de|sv|pl|el|uk|ja|zh|tr|ar)/)?(?:signup|sign-up|register)/?$ /early-access/ [R=302,L]
  RewriteRule ^(?:(?:en|es|nl|fr|de|sv|pl|el|uk|ja|zh|tr|ar)/)?login/?$ https://app.smarty.tel/smarty/login [R=302,L]
  RewriteRule ^(?:(?:en|es|nl|fr|de|sv|pl|el|uk|ja|zh|tr|ar)/)?whats-new/?$ https://doc.smarty.tel/s/kb/doc/whats-new-1ZVswVJlAj [R=302,L]

  # Serve real files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If the build actually lives in public_html/, serve it transparently from /
  RewriteCond %{DOCUMENT_ROOT}/public_html/$1 -f
  RewriteRule ^(.*)$ /public_html/$1 [L]
  RewriteCond %{DOCUMENT_ROOT}/public_html/$1/index.html -f
  RewriteRule ^(.+?)/?$ /public_html/$1/index.html [L]

  # Pretty URLs: /pricing -> /pricing/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # SPA fallback
  RewriteCond %{DOCUMENT_ROOT}/index.html -f
  RewriteRule ^ /index.html [L]
  RewriteRule ^ /public_html/index.html [L]
</IfModule>

DirectoryIndex index.html
Options -Indexes
