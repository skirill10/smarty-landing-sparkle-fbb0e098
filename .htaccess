# Hostinger deploys the repo root into public_html.
# The built static site lives in the public_html/ folder of this repo,
# so serve everything from there.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Don't rewrite requests that already point inside public_html/
  RewriteCond %{REQUEST_URI} ^/public_html/ [OR]
  RewriteCond %{REQUEST_URI} ^/\.well-known/
  RewriteRule ^ - [L]

  # Serve existing files/folders from public_html/
  RewriteCond %{DOCUMENT_ROOT}/public_html%{REQUEST_URI} -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/public_html%{REQUEST_URI} -d
  RewriteRule ^(.*)$ /public_html/$1 [L]

  # SPA fallback: everything else goes to the built index.html
  RewriteRule ^ /public_html/index.html [L]
</IfModule>

DirectoryIndex public_html/index.html index.html
