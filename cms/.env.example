# Database (Postgres on the same VPS)
DATABASE_URI=postgres://smartytel:change-me@localhost:5432/smartytel_cms

# Long random string used to sign auth tokens (openssl rand -hex 32)
PAYLOAD_SECRET=change-me

# Public URL where the CMS is reachable
NEXT_PUBLIC_SERVER_URL=https://cms.smarty.tel

# Origins allowed to read content from the browser
ALLOWED_ORIGINS=https://smarty.tel,https://www.smarty.tel,http://localhost:8080

# Optional: rebuild the static site on publish
GITHUB_REPO=owner/repo
GITHUB_TOKEN=github_pat_xxx
